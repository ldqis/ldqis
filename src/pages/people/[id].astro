---
import { type GetStaticPaths } from "astro";
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ContactLinks from "../../components/ContactLinks.astro";
import Avatar from "../../components/Avatar.astro";
import Nav from "../../components/Nav.astro";
import Subhead from "../../components/Subhead.astro";
import { byRecency } from "../../lib/publications";

// Detail pages for people give each researcher (current + past cohort)
// a stable shareable URL. The lab's previous site had no per-person page;
// alumni had no canonical link to point at from CVs / LinkedIn.
export const getStaticPaths = (async () => {
  const people = await getCollection("people");
  return people.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const {
  initials,
  name,
  role,
  email,
  scholar,
  ieee,
  website,
  github,
  linkedin,
  youtube,
  orcid,
  avatar,
  years,
  cohort,
} = entry.data;
const cohortLabel = cohort === "current" ? "Current team" : "Past cohort";

// Cross-links are computed at build time by walking the source collections
// rather than denormalized on each person entry — one-direction storage
// (project.contributors / publication.author_ids) avoids the bidirectional-
// sync bug class. Projects keep their curated `order`; publications by recency.
const [allProjects, allPublications] = await Promise.all([
  getCollection("projects"),
  getCollection("publications"),
]);
const projectsContributed = allProjects
  .filter((p) => p.data.contributors.some((ref) => ref.id === entry.id))
  .sort((a, b) => a.data.order - b.data.order);
const publicationsAuthored = allPublications
  .filter((p) => p.data.author_ids.some((ref) => ref.id === entry.id))
  .sort(byRecency);
// Books lead (academic-CV convention: a monograph outweighs papers); journal and conference
// papers follow in the Publications list.
const books = publicationsAuthored.filter((p) => p.data.venue_type === "book");
const papers = publicationsAuthored.filter((p) => p.data.venue_type !== "book");
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<BaseLayout
  title={`${name} · LDQIS`}
  description={`${name} — ${role}. ${cohortLabel} member at the Laboratory of Data Quality and Intelligent Security, RIT.`}
>
  <Nav back={{ href: `${baseUrl}/#people`, label: "← All people" }} />

  <main id="main" class="relative z-[1] pt-16 pb-32">
    <article class="mx-auto max-w-[960px] px-6">
      <header class="grid grid-cols-1 items-center gap-8 md:grid-cols-[1fr_auto] md:gap-12">
        <div class="md:order-first">
          <p class="mb-3 text-sm font-medium text-rit-orange-text">{cohortLabel}</p>
          <h1
            class="mb-4"
            style="font-family: var(--font-display); font-size: clamp(40px, 6vw, 64px); line-height: 1.05; letter-spacing: -1px;"
          >
            {name}
          </h1>
          <p class="text-xl text-text-dim">{role}</p>
          {years && <p class="mt-1 text-sm text-text-dim">{years}</p>}
          <div class="mt-7">
            <ContactLinks
              email={email}
              scholar={scholar}
              ieee={ieee}
              website={website}
              github={github}
              linkedin={linkedin}
              youtube={youtube}
              orcid={orcid}
              name={name}
              variant="pill"
            />
          </div>
        </div>
        <Avatar
          avatar={avatar}
          github={github}
          initials={initials}
          name={name}
          size={200}
          class="order-first md:order-last"
          transitionName={`avatar-${entry.id}`}
        />
      </header>

      {[
        { id: "books", title: "Books", items: books },
        { id: "publications", title: "Publications", items: papers },
      ]
        .filter((g) => g.items.length > 0)
        .map((g) => (
          <section class="mt-16" aria-labelledby={`${g.id}-heading`}>
            <Subhead id={`${g.id}-heading`} class="mb-5">
              {g.title}
            </Subhead>
            <ul class="border-t border-line" role="list">
              {g.items.map((pub) => (
                <li class="grid grid-cols-1 gap-x-6 gap-y-1 border-b border-line py-4 sm:grid-cols-[72px_1fr]">
                  <span
                    class="text-text-faint"
                    style="font-family: var(--font-display); font-size: 22px; line-height: 1.2;"
                  >
                    {pub.data.year}
                  </span>
                  <div>
                    <a
                      href={`${baseUrl}/publications/${pub.id}/`}
                      class="text-[16px] leading-snug font-medium hover:text-rit-orange-text"
                    >
                      {pub.data.title}
                    </a>
                    <p class="mt-1 text-[13px] text-text-faint">{pub.data.venue}</p>
                  </div>
                </li>
              ))}
            </ul>
          </section>
        ))}

      {projectsContributed.length > 0 && (
        <section class="mt-16" aria-labelledby="projects-heading">
          <Subhead id="projects-heading" class="mb-5">
            Projects
          </Subhead>
          <ul class="grid grid-cols-1 gap-x-8 border-t border-line sm:grid-cols-2" role="list">
            {projectsContributed.map((project) => (
              <li class="border-b border-line py-4">
                <a
                  href={`${baseUrl}/projects/${project.id}/`}
                  class="hover:text-rit-orange-text"
                  style="font-family: var(--font-display); font-size: 22px; letter-spacing: -0.3px;"
                >
                  {project.data.name}
                </a>
                <p class="text-[13px] text-text-dim">{project.data.tagline}</p>
              </li>
            ))}
          </ul>
        </section>
      )}
    </article>
  </main>
</BaseLayout>
