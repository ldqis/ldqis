---
import { type GetStaticPaths } from "astro";
import { getCollection, render } from "astro:content";
import { Image, getImage } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Nav from "../../components/Nav.astro";

// research(2026-05): Astro's content layer uses `render(entry)` to compile
// Markdown body to a Vue/Astro-renderable Content component. There's no
// reserved `slug` field; routes key off `entry.id` (filename).
// Drafts + future-dated posts are NOT prerendered — getStaticPaths filters
// them out so a 404 is the public surface, not a leaked stub.
export const getStaticPaths = (async () => {
  const now = Date.now();
  const posts = await getCollection("news");
  return posts
    .filter((post) => !post.data.draft && post.data.pubDate.getTime() <= now)
    .map((entry) => ({
      params: { id: entry.id },
      props: { entry },
    }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { title, description, summary, pubDate, tags, author, cover, coverAlt, coverCaption } =
  entry.data;
const { Content } = await render(entry);

const dateFmt = new Intl.DateTimeFormat("en-US", {
  // pubDate is a calendar day parsed as UTC midnight; read it in UTC so no build zone shifts it.
  timeZone: "UTC",
  year: "numeric",
  month: "long",
  day: "numeric",
});

const base = (import.meta.env.BASE_URL || "/").replace(/\/$/, "");
// A post with a cover shares it, cropped to the 1200x630 the layout declares for og:image.
const ogImage = cover
  ? new URL(
      (await getImage({ src: cover, width: 1200, height: 630, fit: "cover", format: "jpg" })).src,
      Astro.site,
    ).href
  : undefined;
---

<BaseLayout title={`${title} · LDQIS News`} description={description ?? summary} {ogImage}>
  <Nav back={{ href: `${base}/news/`, label: "← All news" }} />

  <main id="main" class="relative z-[1] pt-16 pb-32">
    <article class="mx-auto max-w-[760px] px-6">
      <header class="mb-10">
        <div class="mb-4 flex flex-wrap items-baseline gap-4">
          <time
            datetime={pubDate.toISOString()}
            class="text-xs tracking-[1.5px] text-rit-orange-text uppercase"
          >
            {dateFmt.format(pubDate)}
          </time>
          <span class="text-xs tracking-[1.5px] text-text-faint uppercase">{author}</span>
        </div>
        <h1
          class="mb-6"
          style="font-family: var(--font-display); font-size: clamp(36px, 5vw, 56px); line-height: 1.1; letter-spacing: -1px;"
        >
          {title}
        </h1>
        {summary && <p class="text-xl text-text-dim italic">{summary}</p>}
      </header>

      {cover && (
        <figure class="mb-12">
          <Image
            src={cover}
            alt={coverAlt ?? ""}
            widths={[760, 1140, 1520]}
            sizes="(min-width: 808px) 760px, calc(100vw - 48px)"
            loading="eager"
            fetchpriority="high"
            class="w-full rounded-[14px]"
          />
          {coverCaption && (
            <figcaption class="mt-3 text-sm text-text-faint">{coverCaption}</figcaption>
          )}
        </figure>
      )}

      <div class="prose prose-lg max-w-none">
        <Content />
      </div>

      {tags.length > 0 && (
        <ul class="mt-12 flex flex-wrap gap-2 border-t border-line pt-8">
          {tags.map((t) => (
            <li
              class="rounded-full border px-[10px] py-[3px] text-[11px] tracking-[1px] uppercase"
              style="color: var(--color-rit-orange-text); background: color-mix(in oklab, var(--color-rit-orange) 8%, transparent); border-color: color-mix(in oklab, var(--color-rit-orange) 8%, transparent);"
            >
              {t}
            </li>
          ))}
        </ul>
      )}
    </article>
  </main>
</BaseLayout>
