---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import { formatTags } from "../../lib/news";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Nav from "../../components/Nav.astro";
import PageHeader from "../../components/PageHeader.astro";

// Hide drafts AND future-dated posts; mirror the same filter the RSS feed
// uses so the index and feed stay in sync.
const now = Date.now();
const posts = (await getCollection("news"))
  .filter((post) => !post.data.draft && post.data.pubDate.getTime() <= now)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const dateFmt = new Intl.DateTimeFormat("en-US", {
  // pubDate is a calendar day parsed as UTC midnight; read it in UTC so no build zone shifts it.
  timeZone: "UTC",
  year: "numeric",
  month: "long",
  day: "numeric",
});

const base = (import.meta.env.BASE_URL || "/").replace(/\/$/, "");
---

<BaseLayout
  title="News · LDQIS"
  description="News from the Laboratory of Data Quality and Intelligent Security at RIT: research updates, releases, and lab events."
>
  <Nav back={{ href: `${base}/`, label: "← Home" }} />

  <main id="main" class="relative z-[1] pt-16 pb-32">
    <header class="mx-auto max-w-[800px] px-6 pb-12">
      <PageHeader label="News" title="Notes from the lab." />
      <p class="text-lg text-text-dim">
        Research updates, releases, and lab events. Subscribe via{" "}
        <a
          href={base + "/news/rss.xml"}
          class="border-b"
          style="color: var(--color-rit-orange-text); border-color: color-mix(in oklab, var(--color-rit-orange) 25%, transparent);"
        >
          RSS
        </a>
        .
      </p>
    </header>

    {posts.length === 0 ? (
      <p class="mx-auto max-w-[800px] px-6 text-text-dim italic">
        No posts yet. Check back soon, or subscribe via RSS.
      </p>
    ) : (
      <div class="mx-auto max-w-[800px] px-6">
        <ol class="border-t border-line" role="list">
          {posts.map((post) => (
            <li
              class:list={[
                "border-b border-line py-8",
                post.data.cover && "sm:grid sm:grid-cols-[1fr_200px] sm:gap-8",
              ]}
            >
              {post.data.cover && (
                <Image
                  src={post.data.cover}
                  alt=""
                  widths={[400, 600]}
                  sizes="(min-width: 640px) 200px, calc(100vw - 112px)"
                  class="mb-5 aspect-[3/2] w-full rounded-[10px] object-cover sm:order-last sm:mb-0"
                />
              )}
              <div>
                <time
                  datetime={post.data.pubDate.toISOString()}
                  class="mb-2 block text-sm text-text-faint"
                >
                  {dateFmt.format(post.data.pubDate)}
                </time>
                <h2
                  class="mb-3 text-[28px] leading-tight"
                  style="font-family: var(--font-display); letter-spacing: -0.5px;"
                >
                  <a href={`${base}/news/${post.id}/`} class="hover:text-rit-orange-text">
                    {post.data.title}
                  </a>
                </h2>
                <p class="mb-4 text-[15px] text-text-dim">{post.data.summary}</p>
                {post.data.tags.length > 0 && (
                  <p class="text-[13px] text-text-faint">{formatTags(post.data.tags)}</p>
                )}
              </div>
            </li>
          ))}
        </ol>
      </div>
    )}
  </main>
</BaseLayout>
