---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Nav from "../../components/Nav.astro";
import PageHeader from "../../components/PageHeader.astro";
import { SCHOLAR_URL as scholarUrl, basePath } from "../../lib/site-links";
import allPubs from "../../data/publications-all.json";

// The lab's full publication record, built from Dr. Reznik's CV (the authoritative
// list of which papers are his) with clean fields from OpenAlex/Crossref; the
// oldest pre-DOI work that no index carries keeps his exact CV citation. See
// scripts/build-publications.mjs.
const baseUrl = basePath(import.meta.env.BASE_URL);
const linkStyle =
  "color: var(--color-rit-orange-text); border-color: color-mix(in oklab, var(--color-rit-orange) 8%, transparent);";

const byYear = new Map<number, typeof allPubs>();
for (const p of allPubs) {
  if (!byYear.has(p.year)) byYear.set(p.year, []);
  byYear.get(p.year)!.push(p);
}
const years = [...byYear.keys()].sort((a, b) => b - a);
const total = allPubs.length;
const typeLabel: Record<string, string> = {
  book: "Book",
  chapter: "Chapter",
  journal: "Journal",
  conference: "Conference",
};
---

<BaseLayout
  title="Publications · LDQIS"
  description={`The full publication record of Dr. Leon Reznik, ${total} peer-reviewed works, newest first, at the Laboratory of Data Quality and Intelligent Security, RIT.`}
>
  <Nav back={{ href: `${baseUrl}/#publications`, label: "← Home" }} />

  <main id="main" class="relative z-[1] pt-16 pb-32">
    <div class="mx-auto max-w-[920px] px-6">
      <PageHeader label="Publications" title="The full published record." />
      <p class="mb-4 max-w-[64ch] text-lg text-text-dim">
        Dr. Reznik's peer-reviewed books, journal articles, and conference papers, newest first.
      </p>
      <p class="mb-14 text-sm text-text-dim">
        {total} publications. See his{" "}
        <a href={scholarUrl} target="_blank" rel="noopener" class="border-b" style={linkStyle}>
          Google Scholar profile
        </a>{" "}
        for citation metrics.
      </p>

      {years.map((year) => (
        <section class="mb-11">
          <div class="mb-5 flex items-baseline gap-3 border-b border-line pb-2">
            <h2
              class="font-normal"
              style="font-family: var(--font-display); font-size: 30px; letter-spacing: -0.5px; color: var(--color-rit-orange-text);"
            >
              {year}
            </h2>
            <span class="text-[13px] text-text-faint">
              {byYear.get(year)!.length} {byYear.get(year)!.length === 1 ? "paper" : "papers"}
            </span>
          </div>
          <ul class="flex flex-col gap-5">
            {byYear.get(year)!.map((p) => (
              <li class="grid grid-cols-[88px_1fr] gap-x-4">
                <span class="mt-[2px] text-[13px] text-text-faint">
                  {typeLabel[p.type] ?? p.type}
                </span>
                <div class="min-w-0">
                  {p.citation ? (
                    <p class="text-[15px] leading-[1.45] [overflow-wrap:anywhere] text-text-dim">
                      {p.citation}
                      {p.link && (
                        <a
                          href={p.link}
                          target="_blank"
                          rel="noopener"
                          class="ml-1 whitespace-nowrap underline"
                          style="color: var(--color-rit-orange-text);"
                          aria-label="DOI"
                        >
                          ↗
                        </a>
                      )}
                    </p>
                  ) : (
                    <>
                      {p.link ? (
                        <a
                          href={p.link}
                          target="_blank"
                          rel="noopener"
                          class="text-[16px] leading-[1.35] font-medium hover:text-rit-orange-text"
                        >
                          {p.title}
                        </a>
                      ) : (
                        <span class="text-[16px] leading-[1.35] font-medium">{p.title}</span>
                      )}
                      {p.authors && (
                        <div class="mt-[2px] text-[13px] text-text-dim">{p.authors}</div>
                      )}
                      {p.venue && <div class="text-[12px] text-text-faint italic">{p.venue}</div>}
                    </>
                  )}
                </div>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </main>
</BaseLayout>
