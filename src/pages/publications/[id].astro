---
import { type GetStaticPaths } from "astro";
import { getCollection, getEntries, getEntry, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Nav from "../../components/Nav.astro";
import PeopleList from "../../components/PeopleList.astro";
import Subhead from "../../components/Subhead.astro";
import {
  buildCitationTags,
  buildPublicationJsonLd,
  type PublicationData,
} from "../../lib/citation";

// Detail pages for publications keep the venue / authors / year / link
// pattern from the homepage card but give each publication a stable URL
// to cite from external surfaces (LinkedIn, CVs, reading lists). The
// link still resolves off-site to the publisher (IEEE, NSF).
export const getStaticPaths = (async () => {
  const publications = await getCollection("publications");
  return publications.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { year, venue, venue_type, title, authors, author_ids, link, isbn, project } = entry.data;

// research(2026-05): publication detail pages carry Highwire `citation_*`
// meta tags (the format Google Scholar parses) plus a schema.org
// ScholarlyArticle JSON-LD (general search + AI-mode crawlers). Builders +
// rationale live in src/lib/citation.ts.
const pub: PublicationData = { title, authors, year, venue, venueType: venue_type, isbn, link };
const citationTags = buildCitationTags(pub);
// Escape "<" so a title containing "</script>" can't break out of the tag.
const jsonLdScript = JSON.stringify(buildPublicationJsonLd(pub, Astro.url.href)).replace(
  /</g,
  "\\u003c",
);

// Author chip list: each `reference("people")` entry resolves to the full
// person at build time, so a typo'd author id hard-fails the build.
// The flat `authors` string still drives the canonical citation form
// (kept for RSS / CV-style display); `author_ids` adds clickable cross-
// links into per-person detail pages.
const authorEntries = author_ids.length ? await getEntries(author_ids) : [];
// Resolve the optional implementing project so the page can surface a "Code"
// cross-link to it (the project page carries the repo + docs + DOI).
const projectEntry = project ? await getEntry(project) : null;
// An optional Markdown body renders as the abstract (papers) or "About this
// book" (books); a publication without a body simply omits the section.
const { Content } = await render(entry);
const hasBody = Boolean(entry.body?.trim());
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<BaseLayout
  title={`${title} · LDQIS`}
  description={`${title} — ${authors}, ${venue}, ${year}. A publication from the Laboratory of Data Quality and Intelligent Security at RIT.`}
>
  <Fragment slot="head">
    {citationTags.map((tag) => (
      <meta name={tag.name} content={tag.content} />
    ))}
    <script is:inline type="application/ld+json" set:html={jsonLdScript}></script>
  </Fragment>

  <Nav back={{ href: `${baseUrl}/#publications`, label: "← All publications" }} />

  <main id="main" class="relative z-[1] pt-16 pb-32">
    <article class="mx-auto max-w-[800px] px-6">
      <p class="mb-4 text-sm font-medium text-rit-orange-text">
        {venue}, {year}
      </p>

      <h1
        class="mb-5"
        style="font-family: var(--font-display); font-size: clamp(30px, 4.5vw, 46px); line-height: 1.12; letter-spacing: -0.5px;"
      >
        {title}
      </h1>

      <p class="mb-8 text-lg text-text-dim">{authors}</p>

      <div class="mb-12 flex flex-wrap gap-x-6 gap-y-2 text-[15px]">
        <a
          href={link.href}
          target="_blank"
          rel="noopener"
          class="text-rit-orange-text underline-offset-4 hover:underline"
        >
          {link.label}
        </a>
        {projectEntry && (
          <a
            href={`${baseUrl}/projects/${projectEntry.id}/`}
            class="text-rit-orange-text underline-offset-4 hover:underline"
          >
            Code: {projectEntry.data.name}
          </a>
        )}
      </div>

      {hasBody && (
        <section class="mb-14" aria-labelledby="about-heading">
          <Subhead id="about-heading" class="mb-4">
            {venue_type === "book" ? "About this book" : "Abstract"}
          </Subhead>
          <div class="prose max-w-none">
            <Content />
          </div>
        </section>
      )}

      {authorEntries.length > 0 && (
        <section aria-labelledby="authors-heading">
          <Subhead id="authors-heading" class="mb-5">
            Lab authors
          </Subhead>
          <PeopleList people={authorEntries} label="Author profile links" />
        </section>
      )}
    </article>
  </main>
</BaseLayout>
