---
import { type GetStaticPaths } from "astro";
import { getCollection, getEntries } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ExperimentStats from "../../components/ExperimentStats.astro";
import Nav from "../../components/Nav.astro";
import { summarize } from "../../lib/experiment-stats";

// research(2026-05): Astro's dynamic-route IDs come from filenames via
// `glob({ pattern })` — no reserved `slug` field anymore. `entry.id` is
// the URL-friendly basename. Source:
// https://docs.astro.build/en/reference/content-loader-reference/
export const getStaticPaths = (async () => {
  const projects = await getCollection("projects");
  return projects.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { name, tagline, tags, stack, desc, links, contributors, status } = entry.data;

// `getEntries` resolves each `reference("people")` into the full entry, in
// the order the IDs were listed in frontmatter. Build hard-fails if any ID
// doesn't resolve, so a typo can't silently render a broken card.
const contributorEntries = contributors.length ? await getEntries(contributors) : [];
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");
// Projects with a public experiment database (an experimentStats entry under the same id).
const stats = (await getCollection("experimentStats")).find((s) => s.id === entry.id);
---

<BaseLayout
  title={`${name} · LDQIS`}
  description={`${name} — ${tagline}. An open-source project from the Laboratory of Data Quality and Intelligent Security at RIT.`}
>
  <Nav back={{ href: `${baseUrl}/#projects`, label: "← All projects" }} />

  <main id="main" class="relative z-[1] pt-16 pb-32">
    <article class="mx-auto max-w-[800px] px-6">
      <div class="mb-6 flex flex-wrap items-center gap-3">
        {tags.map((t) => (
          <span
            class="rounded-full border px-[10px] py-[3px] text-[11px] tracking-[1px] uppercase"
            style="color: var(--color-rit-orange-text); background: color-mix(in oklab, var(--color-rit-orange) 8%, transparent); border-color: color-mix(in oklab, var(--color-rit-orange) 8%, transparent);"
          >
            {t}
          </span>
        ))}
      </div>

      <h1
        class="mb-3"
        style="font-family: var(--font-display); font-size: clamp(40px, 6vw, 64px); line-height: 1.05; letter-spacing: -1px;"
      >
        {name}
      </h1>

      <p class="mb-8 text-xl text-text-dim italic">{tagline}</p>

      {status === "paused" && (
        <p class="mb-8 text-sm text-text-dim">
          Paused: no longer in active development. The code and documentation stay public.
        </p>
      )}

      <div class="mb-8 font-mono text-sm text-text-faint">{stack.join(" · ")}</div>

      <div class="prose prose-lg mb-12 max-w-none" set:html={desc} />

      <div class="flex flex-wrap gap-[14px] border-t border-line pt-8">
        {links.map((l) => (
          <a
            href={l.href}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-2 rounded-full border border-line px-[18px] py-[10px] text-sm hover:border-rit-orange hover:text-rit-orange-text"
          >
            {l.label}
          </a>
        ))}
      </div>

      {stats && (
        <ExperimentStats
          view={summarize(stats.data)}
          dataHref={`${baseUrl}/data/${entry.id}-experiments.json`}
        />
      )}

      {contributorEntries.length > 0 && (
        <section class="mt-12 border-t border-line pt-8" aria-labelledby="contributors-heading">
          <h2
            id="contributors-heading"
            class="mb-4 text-xs tracking-[1.5px] text-text-faint uppercase"
          >
            Contributors
          </h2>
          <ul class="flex flex-wrap gap-3" role="list">
            {contributorEntries.map((person) => (
              <li>
                <a
                  href={`${baseUrl}/people/${person.id}/`}
                  class="inline-flex items-center gap-2 rounded-full border border-line px-[14px] py-[8px] text-sm hover:border-rit-orange hover:text-rit-orange-text"
                >
                  <span
                    class="flex h-6 w-6 items-center justify-center rounded-full text-[10px] font-semibold"
                    style="background: linear-gradient(135deg, var(--color-rit-orange), var(--color-rit-yellow)); color: #0a0e13;"
                    aria-hidden="true"
                  >
                    {person.data.initials}
                  </span>
                  {person.data.name}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}
    </article>
  </main>
</BaseLayout>
