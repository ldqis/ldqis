---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import Nav from "../components/Nav.astro";
import ProjectCard from "../components/ProjectCard.astro";
import SectionHeader from "../components/SectionHeader.astro";
import Subhead from "../components/Subhead.astro";
import PersonCard from "../components/PersonCard.astro";
import HeroPulse from "../components/HeroPulse.astro";
import ContactLinks from "../components/ContactLinks.astro";
import { byRecency } from "../lib/publications";
import { CONTACT_EMAIL, SCHOLAR_URL } from "../lib/site-links";
import allPubs from "../data/publications-all.json";

// research(2026-05): projects / publications / people live in Astro content
// collections. The remaining inline `researchAreas` array stays
// here — it's short structural copy that lives with the homepage section,
// not the per-detail-page surface the collections target. See
// `src/content.config.ts` for collection schemas. Sources:
// https://docs.astro.build/en/guides/content-collections/
// https://docs.astro.build/en/reference/content-loader-reference/

const researchAreas = [
  {
    title: "Federated Learning",
    desc: "Privacy-preserving model training across distributed clients: designing protocols, aggregation strategies, and threat models for collaborative ML without centralizing sensitive data.",
  },
  {
    title: "Data Quality at Scale",
    desc: "Provable quality metrics for streaming sensor data, with frameworks for evaluating fitness-for-purpose across heterogeneous sources.",
  },
  {
    title: "ML System Security",
    desc: "Adversarial robustness, model integrity, and runtime monitoring for ML systems deployed in safety-critical environments.",
  },
  {
    title: "Edge Intelligence",
    desc: "Neural network architectures and inference systems designed for the power, privacy, and reliability constraints of edge deployment.",
  },
  {
    title: "Verifiable Mobile Security",
    desc: "Building on the lab's shipped Android apps (Android System Security Evaluation and Detector of Unverified Apps on Google Play) into continuous verification for app supply-chain integrity.",
  },
  {
    title: "Open-Source Tooling",
    desc: "Releasing reproducible benchmarks, evaluation frameworks, and reference implementations the community can build on.",
  },
];

// research(2026-06): the lab's funded awards, shown as a "Funded By" credibility
// band. Inline like `researchAreas` (homepage-only, no detail page). NSF titles +
// dates verified against the NSF Awards API (api.nsf.gov); non-NSF awards have no
// public award page, so `url` is null and they link nowhere. The federal-funding
// disclaimer under the grid follows NSF policy 14.9. Sources: nsf.gov/awardsearch,
// research.howard.edu federal-sponsor acknowledgment guidance.
const funders = [
  {
    agency: "National Science Foundation",
    program: "Ideas Lab: Smarter Microbial Observatories for Realtime Experiments (SMORES)",
    award: "#2321652",
    years: "2023–2027",
    url: "https://www.nsf.gov/awardsearch/show-award/?AWD_ID=2321652",
  },
  {
    agency: "National Science Foundation",
    program: "IMPRESS-U: Robust Machine Learning for Object Detection & Classification",
    award: "#2415299",
    years: "2024–2027",
    url: "https://www.nsf.gov/awardsearch/show-award/?AWD_ID=2415299",
  },
  {
    agency: "National Science Foundation",
    program:
      "CICI Data Provenance: Data Quality & Security Evaluation Framework for Mobile Platforms",
    award: "#1547301",
    years: "2016–2021",
    url: "https://www.nsf.gov/awardsearch/show-award/?AWD_ID=1547301",
  },
  {
    agency: "U.S. Department of Defense",
    program: "Army Research Office award",
    award: "#W911NF2010337",
    years: "2020–2022",
    url: null,
  },
  {
    agency: "CRDF Global · U.S. Department of State",
    program: "International collaborative research award",
    award: "#G-202102-67515",
    years: "2021–2022",
    url: null,
  },
];

// research(2026-06): courses the lab teaches, shown as a thin "Teaching" list —
// a curriculum + credibility signal, not a per-course collection. The ROADMAP
// rules out hosting syllabi/schedules ourselves (catalog duplication + staleness),
// so this links out to the instructor's maintained course pages instead. Inline
// like `funders` (homepage-only, no detail page). Course codes are the identity
// anchor; titles follow Dr. Reznik's current faculty list (cs.rit.edu/~lr) — the
// official RIT AI listing names CSCI-630 "Foundations of Artificial Intelligence"
// and confirms 735/736 verbatim. Sources: cs.rit.edu/~lr, rit.edu/ai/graduate-courses.
const courses = [
  { code: "CSCI-331", title: "Introduction to Intelligent Systems", level: "Undergraduate" },
  { code: "CSCI-531", title: "Introduction to Security Measurement", level: "Undergraduate" },
  {
    code: "CSCI-532",
    title: "Introduction to Intelligent Security Systems",
    level: "Undergraduate",
  },
  { code: "CSCI-630", title: "Foundations of Intelligent Systems", level: "Graduate" },
  {
    code: "CSCI-734",
    title: "Foundations of Security Measurement and Evaluation",
    level: "Graduate",
  },
  { code: "CSCI-735", title: "Foundations of Intelligent Security Systems", level: "Graduate" },
  { code: "CSCI-736", title: "Neural Networks and Machine Learning", level: "Graduate" },
  { code: "CSCI-788", title: "MS Capstone Project", level: "Graduate" },
];

const projectEntries = await getCollection("projects");
const projects = projectEntries
  .sort((a, b) => a.data.order - b.data.order)
  .map((entry) => ({ ...entry.data, id: entry.id }));
const research = projects.filter((p) => p.kind === "research");
const software = projects.filter((p) => p.kind === "software");

// Projects with an experiment database get a run count on their card; InteFL's record also
// draws the hero strip.
const experimentEntries = await getCollection("experimentStats");
const experimentTotals = new Map(experimentEntries.map((s) => [s.id, s.data.total_experiments]));
const inteflStats = experimentEntries.find((s) => s.id === "intefl");

// Lookup for the optional publication → project "Code" cross-link below.
const projectNamesById = new Map(projectEntries.map((p) => [p.id, p.data.name]));

const publicationEntries = await getCollection("publications");
const publications = publicationEntries
  .filter((entry) => entry.data.featured)
  .sort(byRecency)
  .map((entry) => ({ ...entry.data, id: entry.id }));

const peopleEntries = await getCollection("people");
const currentTeam = peopleEntries
  .filter((entry) => entry.data.cohort === "current")
  .sort((a, b) => a.data.order - b.data.order)
  .map((entry) => ({ ...entry.data, id: entry.id }));
const pastCohort = peopleEntries
  .filter((entry) => entry.data.cohort === "past")
  // Alumni sort alphabetically by name (leading honorific ignored), so a new
  // graduate slots in by name instead of inheriting an arbitrary `order`.
  .sort((a, b) =>
    a.data.name
      .replace(/^(Dr|Prof)\.?\s+/i, "")
      .localeCompare(b.data.name.replace(/^(Dr|Prof)\.?\s+/i, "")),
  )
  .map((entry) => ({ ...entry.data, id: entry.id }));
---

<BaseLayout>
  {/* NAV */}
  <Nav />

  <main id="main" class="relative z-[1] mb-20">
    {/* HERO */}
    <header class="relative pt-[120px] pb-[100px]">
      <div class="mx-auto max-w-[1200px] px-6">
        <p class="mb-8 text-sm text-text-dim">
          Laboratory of Data Quality and Intelligent Security, Department of Computer Science,
          Rochester Institute of Technology
        </p>
        {/* The <br /> sets the two lines; a ch-based max-width would wrap differently in the
            fallback font than in Instrument Serif and shift the page when the font arrives. */}
        <h1
          class="mb-7"
          style="font-family: var(--font-display); font-size: clamp(48px, 8vw, 104px); font-weight: 400; line-height: 1; letter-spacing: -2px;"
        >
          Trustworthy data.
          <br />
          <em class="italic">Intelligent security.</em>
        </h1>
        <p class="mb-10 max-w-[56ch] text-lg text-text-dim">
          We build the methods, models, and systems that make modern data infrastructure verifiable,
          resilient, and worthy of trust, from sensor networks at the edge to large-scale machine
          learning at the core.
        </p>
        <div class="flex flex-wrap gap-[14px]">
          <a
            href="#research"
            class="inline-flex items-center rounded-full px-[22px] py-[14px] text-sm font-medium transition-transform hover:-translate-y-[1px]"
            style="background: var(--color-rit-orange); color: #0a0e13;"
          >
            Explore the research
          </a>
          <a
            href="#support"
            class="inline-flex items-center rounded-full border border-line px-[22px] py-[14px] text-sm font-medium text-text hover:border-text-dim"
          >
            Support our work
          </a>
        </div>

        {inteflStats && (
          <div class="mt-20">
            <HeroPulse
              stats={inteflStats.data}
              href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/projects/intefl/#experiments`}
            />
          </div>
        )}

        {/* research(2026-05): Dr. Reznik joined RIT around 2003 (no source gives the exact year),
            so "over 20 years" rounds down. research(2026-06): the publication count is his whole imported record
            (src/data/publications-all.json, the figure /publications shows), which starts in 1981
            and includes books and chapters, so it is attributed to his record, not to the lab's
            RIT years; "+" hedges OpenAlex coverage gaps. The project count is the collection. */}
        <p class="mt-8 max-w-[64ch] text-[15px] text-text-dim">
          For over 20 years the lab has trained 25+ researchers and released {projects.length}{" "}
          open-source projects, and Dr. Reznik's publication record spans {allPubs.length}+ papers,
          books, and chapters.
        </p>
      </div>
    </header>

    {/* RESEARCH AREAS */}
    <section id="research" class="relative py-16 md:py-[100px]">
      <div class="mx-auto max-w-[1200px] px-6">
        <SectionHeader label="Research areas" title="Six frontiers we're pushing in parallel.">
          Our work sits at the intersection of data quality, security, and intelligent systems, with
          a hard focus on what's deployable, measurable, and trustworthy.
        </SectionHeader>
        <ul class="grid grid-cols-1 gap-x-12 md:grid-cols-2 lg:grid-cols-3" role="list">
          {researchAreas.map((area) => (
            <li class="border-t border-line pt-6 pb-12">
              <Subhead as="h3" size={28} class="mb-3">
                {area.title}
              </Subhead>
              <p class="max-w-[42ch] text-[15px] leading-relaxed text-text-dim">{area.desc}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    {/* PROJECTS */}
    <section id="projects" data-pagefind-ignore class="relative py-16 md:py-[100px]">
      <div class="mx-auto max-w-[1200px] px-6">
        <SectionHeader label="Projects" title="What we're shipping right now.">
          Open-source frameworks, peer-reviewed methods, and end-to-end systems, built by the
          current cohort and used by researchers beyond LDQIS.
        </SectionHeader>
        <Subhead as="h3" size={36} class="mb-3">
          Research projects
        </Subhead>
        <p class="mb-8 max-w-[64ch] text-text-dim">
          The software behind the lab's studies: frameworks, testbeds, and experiments with research
          questions and papers behind them.
        </p>
        <div class="grid grid-cols-1 gap-x-12 md:grid-cols-2">
          {research.map((p) => (
            <ProjectCard p={p} experimentTotal={experimentTotals.get(p.id)} />
          ))}
        </div>
        {software.length > 0 && (
          <>
            <Subhead as="h3" size={36} class="mt-16 mb-3">
              Agentic AI tools
            </Subhead>
            <p class="mb-8 max-w-[64ch] text-text-dim">
              Open-source tools for working with AI coding agents such as Claude Code, built for the
              lab's own research and free for anyone to use.
            </p>
            <div class="grid grid-cols-1 gap-x-12 md:grid-cols-2 lg:grid-cols-3">
              {software.map((p) => (
                <ProjectCard p={p} compact />
              ))}
            </div>
          </>
        )}
      </div>
    </section>

    {/* PUBLICATIONS */}
    <section id="publications" data-pagefind-ignore class="relative py-16 md:py-[100px]">
      <div class="mx-auto max-w-[1200px] px-6">
        <SectionHeader label="Publications" title="Selected publications.">
          A handful of highlights from the lab's work. See the full publication record below, or Dr.
          Reznik's{" "}
          <a
            href={SCHOLAR_URL}
            target="_blank"
            rel="noopener"
            class="border-b"
            style="color: var(--color-rit-orange-text); border-color: color-mix(in oklab, var(--color-rit-orange) 8%, transparent);"
          >
            Google Scholar profile
          </a>{" "}
          for citation metrics.
        </SectionHeader>
        <ol class="divide-y divide-line border-y border-line" role="list">
          {publications.map((pub) => (
            <li class="grid grid-cols-1 gap-x-8 gap-y-2 py-7 md:grid-cols-[88px_1fr_auto]">
              <div
                class="text-text-faint"
                style="font-family: var(--font-display); font-size: 30px; line-height: 1; letter-spacing: -0.5px;"
              >
                {pub.year}
              </div>
              <div class="min-w-0">
                <p class="mb-1 text-[13px] text-text-faint">{pub.venue}</p>
                <a
                  href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/publications/${pub.id}/`}
                  class="mb-1 inline-block max-w-[70ch] text-[18px] leading-[1.35] font-medium hover:text-rit-orange-text"
                >
                  {pub.title}
                </a>
                <p class="text-[14px] text-text-dim">{pub.authors}</p>
                {pub.project && (
                  <a
                    href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/projects/${pub.project.id}/`}
                    class="mt-2 inline-block text-[13px] text-rit-orange-text underline-offset-4 hover:underline"
                  >
                    Code: {projectNamesById.get(pub.project.id)}
                  </a>
                )}
              </div>
              <a
                href={pub.link.href}
                target="_blank"
                rel="noopener"
                class="self-start text-sm whitespace-nowrap text-rit-orange-text underline-offset-4 hover:underline"
              >
                {pub.link.label}
                <span class="sr-only"> ({pub.title})</span>
              </a>
            </li>
          ))}
        </ol>
        <div class="mt-12">
          <a
            href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/publications/`}
            class="text-[15px] font-medium text-rit-orange-text underline-offset-4 hover:underline"
          >
            See all {allPubs.length} publications
          </a>
        </div>
      </div>
    </section>

    {/* PEOPLE */}
    <section
      id="people"
      data-pagefind-ignore
      class="relative py-16 md:py-[100px]"
      style="background: var(--color-bg-elev); border-top: 1px solid var(--color-line); border-bottom: 1px solid var(--color-line);"
    >
      <div class="mx-auto max-w-[1200px] px-6">
        <SectionHeader label="People" title="The team, past and present.">
          LDQIS is the work of every researcher who has passed through it. Today's team is pushing
          on federated learning and agentic AI; previous cohorts built the foundations in mobile
          security, data quality evaluation, wearable sensors, and computational intelligence that
          made today's work possible.
        </SectionHeader>

        <Subhead as="h3" size={36} class="mb-2">
          Current team
        </Subhead>
        <p class="mb-8 text-text-dim">Working on federated learning and agentic AI.</p>
        <div class="grid grid-cols-1 gap-x-10 sm:grid-cols-2 md:grid-cols-4">
          {currentTeam.map((p) => (
            <PersonCard p={p} />
          ))}
        </div>

        <Subhead as="h3" id="alumni" size={36} class="mt-16 mb-2">
          Past research cohort
        </Subhead>
        <p class="mb-8 max-w-[64ch] text-text-dim">
          These researchers led work that remains foundational to LDQIS today, including our Android
          security apps, the NSF Data Quality &amp; Security Evaluation Framework, and the
          wearable-sensors and computational-intelligence research lines that preceded today's
          federated learning work. Their topics ranged from mobile security and Android attacks to
          wearable sensors, data quality, and computational intelligence.
        </p>
        {/* A compact text list: past members have no photos, so initials circles added noise,
            not information. Each name links to the person's page with their full details. */}
        <ul
          class="grid grid-cols-1 gap-x-10 border-t border-line sm:grid-cols-2 lg:grid-cols-3"
          role="list"
        >
          {pastCohort.map((p) => (
            <li class="border-b border-line py-3">
              <a
                href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/people/${p.id}/`}
                class="text-[15px] font-medium text-text hover:text-rit-orange-text"
              >
                {p.name}
              </a>
              <p class="text-[13px] text-text-dim">
                {p.role}
                {p.years && <span>, {p.years}</span>}
              </p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    {/* TEACHING */}
    <section id="teaching" class="relative py-16 md:py-[100px]">
      <div class="mx-auto max-w-[1200px] px-6">
        <SectionHeader label="Teaching" title="From the lecture hall to the lab.">
          Lab members teach across RIT's undergraduate and graduate computer science curriculum, in
          the same areas the lab researches, from intelligent systems and security measurement to
          neural networks and intelligent security. Dr. Reznik's{" "}
          <a
            href="https://www.cs.rit.edu/~lr/"
            target="_blank"
            rel="noopener"
            class="border-b"
            style="color: var(--color-rit-orange-text); border-color: color-mix(in oklab, var(--color-rit-orange) 8%, transparent);"
          >
            course pages
          </a>{" "}
          have schedules and current materials.
        </SectionHeader>
        <div class="grid grid-cols-1 gap-x-12 gap-y-12 md:grid-cols-2">
          {["Undergraduate", "Graduate"].map((level) => {
            const items = courses.filter((c) => c.level === level);
            return (
              <div>
                <div class="mb-4 flex items-baseline justify-between gap-4">
                  <Subhead as="h3" size={28}>
                    {level}
                  </Subhead>
                  <span class="text-[13px] text-text-faint">{items.length} courses</span>
                </div>
                <ul class="border-t border-line">
                  {items.map((c) => (
                    <li class="flex flex-col gap-1 border-b border-line py-4 sm:flex-row sm:items-baseline sm:gap-4">
                      <span class="text-[13px] text-text-faint tabular-nums sm:w-[84px] sm:shrink-0">
                        {c.code}
                      </span>
                      <span class="text-[16px] leading-[1.3]">{c.title}</span>
                    </li>
                  ))}
                </ul>
              </div>
            );
          })}
        </div>
      </div>
    </section>

    {/* FUNDED BY */}
    <section id="funding" class="relative py-16 md:py-[100px]">
      <div class="mx-auto max-w-[1200px] px-6">
        <SectionHeader label="Funded by" title="Backed by competitive research awards.">
          LDQIS research has been supported by the National Science Foundation, the U.S. Department
          of Defense, and CRDF Global with the U.S. Department of State.
        </SectionHeader>
        <ol class="divide-y divide-line border-y border-line" role="list">
          {funders.map((f) => (
            <li class="grid grid-cols-1 gap-x-8 gap-y-2 py-6 md:grid-cols-[1fr_auto] md:items-baseline">
              <div>
                <p class="mb-1 text-[13px] text-text-faint">{f.agency}</p>
                <p class="max-w-[60ch] text-[18px] leading-[1.35] font-medium">{f.program}</p>
              </div>
              <div class="flex flex-wrap items-baseline gap-x-5 gap-y-1 text-sm text-text-dim md:justify-end">
                <span class="tabular-nums">Award {f.award.replace(/^#/, "")}</span>
                <span class="tabular-nums">{f.years}</span>
                {f.url && (
                  <a
                    href={f.url}
                    target="_blank"
                    rel="noopener"
                    class="text-rit-orange-text underline-offset-4 hover:underline"
                    aria-label={`View award ${f.award} on nsf.gov`}
                  >
                    View award
                  </a>
                )}
              </div>
            </li>
          ))}
        </ol>
        <p class="mt-10 max-w-[80ch] text-xs leading-[1.7] text-text-faint">
          Any opinions, findings, and conclusions or recommendations expressed on this site are
          those of the authors and do not necessarily reflect the views of the National Science
          Foundation, the U.S. Department of Defense, or other funding agencies.
        </p>
      </div>
    </section>

    {/* GET INVOLVED */}
    <section id="support" class="relative pt-4 pb-16 md:pt-8 md:pb-24">
      <div class="mx-auto max-w-[1200px] px-6">
        <div
          class="relative overflow-hidden rounded-[14px] border border-line px-6 py-12 text-center md:px-12 md:py-14"
          style="background: linear-gradient(135deg, var(--color-bg-soft), var(--color-bg-elev));"
        >
          <div
            class="pointer-events-none absolute"
            style="top: -50%; left: 50%; transform: translateX(-50%); width: 600px; height: 600px; background: radial-gradient(circle, color-mix(in oklab, var(--color-rit-orange) 8%, transparent), transparent 70%);"
          ></div>
          <div class="relative">
            <p class="mb-4 text-sm font-medium text-rit-orange-text">Get involved</p>
            <h3
              class="mx-auto mb-4 max-w-[22ch]"
              style="font-family: var(--font-display); font-size: clamp(32px, 4vw, 48px); line-height: 1.1;"
            >
              Support research that makes data trustworthy.
            </h3>
            <p class="mx-auto mb-12 max-w-[50ch] text-text-dim">
              Funding from individuals, foundations, and industry partners directly supports
              graduate stipends, equipment, and open-source releases.
            </p>
            {/* research(2026-10): a mailto button hides the address and dead-ends for anyone
                without a desktop mail app, so the partner path shows the address with a copy
                button (the profile pages' email chip) and still opens mail on click. Sources:
                adamsilver.io "The trouble with mailto email links", SMU web guidelines. */}
            <div class="mx-auto grid max-w-[880px] grid-cols-1 gap-10 text-left md:grid-cols-2 md:gap-0 md:divide-x md:divide-line">
              <div class="md:pr-10">
                <h4 class="mb-2 text-lg font-medium text-text">Give</h4>
                <p class="mb-5 text-[15px] text-text-dim">
                  Gifts to the lab are made through RIT. To make sure yours reaches LDQIS, email us
                  before you give and we will point you to the right designation.
                </p>
                <a
                  href="https://www.rit.edu/giving/"
                  target="_blank"
                  rel="noopener"
                  class="inline-flex items-center rounded-full px-[22px] py-[12px] text-sm font-medium transition-transform hover:-translate-y-[1px]"
                  style="background: var(--color-rit-orange); color: #0a0e13;"
                >
                  Give through RIT ↗<span class="sr-only"> (opens rit.edu in a new tab)</span>
                </a>
              </div>
              <div class="md:pl-10">
                <h4 class="mb-2 text-lg font-medium text-text">Partner</h4>
                <p class="mb-5 text-[15px] text-text-dim">
                  Industry and research partners sponsor projects, students, and open-source
                  releases. Email Dr. Reznik's lab to start a conversation.
                </p>
                <ContactLinks email={CONTACT_EMAIL} name="LDQIS" variant="pill" />
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
