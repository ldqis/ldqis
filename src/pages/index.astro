---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import ContactLinks from "../components/ContactLinks.astro";
import Avatar from "../components/Avatar.astro";
import Nav from "../components/Nav.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { byRecency } from "../lib/publications";
import { SCHOLAR_URL } from "../lib/site-links";
import allPubs from "../data/publications-all.json";

// research(2026-05): projects / publications / people live in Astro content
// collections. The remaining inline `researchAreas` array stays
// here — it's short structural copy that lives with the homepage section,
// not the per-detail-page surface the collections target. See
// `src/content.config.ts` for collection schemas. Sources:
// https://docs.astro.build/en/guides/content-collections/
// https://docs.astro.build/en/reference/content-loader-reference/

const researchAreas = [
  {
    n: "01",
    title: "Federated Learning",
    desc: "Privacy-preserving model training across distributed clients — designing protocols, aggregation strategies, and threat models for collaborative ML without centralizing sensitive data.",
  },
  {
    n: "02",
    title: "Data Quality at Scale",
    desc: "Provable quality metrics for streaming sensor data, with frameworks for evaluating fitness-for-purpose across heterogeneous sources.",
  },
  {
    n: "03",
    title: "ML System Security",
    desc: "Adversarial robustness, model integrity, and runtime monitoring for ML systems deployed in safety-critical environments.",
  },
  {
    n: "04",
    title: "Edge Intelligence",
    desc: "Neural network architectures and inference systems designed for the power, privacy, and reliability constraints of edge deployment.",
  },
  {
    n: "05",
    title: "Verifiable Mobile Security",
    desc: "Building on the lab's shipped Android apps — Android System Security Evaluation and Detector of Unverified Apps on Google Play — into continuous verification for app supply-chain integrity.",
  },
  {
    n: "06",
    title: "Open-Source Tooling",
    desc: "Releasing reproducible benchmarks, evaluation frameworks, and reference implementations the community can build on.",
  },
];

// research(2026-06): the lab's funded awards, shown as a "Funded By" credibility
// band. Inline like `researchAreas` (homepage-only, no detail page). NSF titles +
// dates verified against the NSF Awards API (api.nsf.gov); non-NSF awards have no
// public award page, so `url` is null and they link nowhere. The federal-funding
// disclaimer under the grid follows NSF policy 14.9. Sources: nsf.gov/awardsearch,
// research.howard.edu federal-sponsor acknowledgment guidance.
const funders = [
  {
    agency: "National Science Foundation",
    program: "Ideas Lab — Smarter Microbial Observatories for Realtime Experiments (SMORES)",
    award: "#2321652",
    years: "2023–2027",
    url: "https://www.nsf.gov/awardsearch/show-award/?AWD_ID=2321652",
  },
  {
    agency: "National Science Foundation",
    program: "IMPRESS-U — Robust Machine Learning for Object Detection & Classification",
    award: "#2415299",
    years: "2024–2027",
    url: "https://www.nsf.gov/awardsearch/show-award/?AWD_ID=2415299",
  },
  {
    agency: "National Science Foundation",
    program:
      "CICI Data Provenance — Data Quality & Security Evaluation Framework for Mobile Platforms",
    award: "#1547301",
    years: "2016–2021",
    url: "https://www.nsf.gov/awardsearch/show-award/?AWD_ID=1547301",
  },
  {
    agency: "U.S. Department of Defense",
    program: "Army Research Office award",
    award: "#W911NF2010337",
    years: "2020–2022",
    url: null,
  },
  {
    agency: "CRDF Global · U.S. Department of State",
    program: "International collaborative research award",
    award: "#G-202102-67515",
    years: "2021–2022",
    url: null,
  },
];

// research(2026-06): courses the lab teaches, shown as a thin "Teaching" list —
// a curriculum + credibility signal, not a per-course collection. The ROADMAP
// rules out hosting syllabi/schedules ourselves (catalog duplication + staleness),
// so this links out to the instructor's maintained course pages instead. Inline
// like `funders` (homepage-only, no detail page). Course codes are the identity
// anchor; titles follow Dr. Reznik's current faculty list (cs.rit.edu/~lr) — the
// official RIT AI listing names CSCI-630 "Foundations of Artificial Intelligence"
// and confirms 735/736 verbatim. Sources: cs.rit.edu/~lr, rit.edu/ai/graduate-courses.
const courses = [
  { code: "CSCI-331", title: "Introduction to Intelligent Systems", level: "Undergraduate" },
  { code: "CSCI-531", title: "Introduction to Security Measurement", level: "Undergraduate" },
  {
    code: "CSCI-532",
    title: "Introduction to Intelligent Security Systems",
    level: "Undergraduate",
  },
  { code: "CSCI-630", title: "Foundations of Intelligent Systems", level: "Graduate" },
  {
    code: "CSCI-734",
    title: "Foundations of Security Measurement and Evaluation",
    level: "Graduate",
  },
  { code: "CSCI-735", title: "Foundations of Intelligent Security Systems", level: "Graduate" },
  { code: "CSCI-736", title: "Neural Networks and Machine Learning", level: "Graduate" },
  { code: "CSCI-788", title: "MS Capstone Project", level: "Graduate" },
];

const projectEntries = await getCollection("projects");
const projects = projectEntries
  .sort((a, b) => a.data.order - b.data.order)
  .map((entry) => ({ ...entry.data, id: entry.id }));
const research = projects.filter((p) => p.kind === "research");
const software = projects.filter((p) => p.kind === "software");

// Projects with an experiment database get a run count on their card.
const experimentTotals = new Map(
  (await getCollection("experimentStats")).map((s) => [s.id, s.data.total_experiments]),
);

// Lookup for the optional publication → project "Code" cross-link below.
const projectNamesById = new Map(projectEntries.map((p) => [p.id, p.data.name]));

const publicationEntries = await getCollection("publications");
const publications = publicationEntries
  .sort(byRecency)
  .map((entry) => ({ ...entry.data, id: entry.id }));

const peopleEntries = await getCollection("people");
const currentTeam = peopleEntries
  .filter((entry) => entry.data.cohort === "current")
  .sort((a, b) => a.data.order - b.data.order)
  .map((entry) => ({ ...entry.data, id: entry.id }));
const pastCohort = peopleEntries
  .filter((entry) => entry.data.cohort === "past")
  // Alumni sort alphabetically by name (leading honorific ignored), so a new
  // graduate slots in by name instead of inheriting an arbitrary `order`.
  .sort((a, b) =>
    a.data.name
      .replace(/^(Dr|Prof)\.?\s+/i, "")
      .localeCompare(b.data.name.replace(/^(Dr|Prof)\.?\s+/i, "")),
  )
  .map((entry) => ({ ...entry.data, id: entry.id }));
---

<BaseLayout>
  {/* NAV */}
  <Nav />

  <main id="main" class="relative z-[1] mb-20">
    {/* HERO */}
    <header class="relative pt-[120px] pb-[100px]">
      <div class="mx-auto max-w-[1200px] px-6">
        <div class="mb-8 inline-flex items-center gap-2 rounded-full border border-line bg-bg-soft px-3 py-[6px] text-xs text-text-dim">
          <span
            class="h-[6px] w-[6px] rounded-full bg-rit-orange"
            style="box-shadow: 0 0 12px var(--color-rit-orange);"
          ></span>
          Rochester Institute of Technology · Department of Computer Science
        </div>
        <h1
          class="mb-7 max-w-[14ch]"
          style="font-family: var(--font-display); font-size: clamp(48px, 8vw, 96px); font-weight: 400; line-height: 1.02; letter-spacing: -2px;"
        >
          Trustworthy data.
          <br />
          <em class="italic" style="color: var(--color-rit-orange-text);">
            Intelligent
          </em>{" "}
          security.
        </h1>
        <p class="mb-10 max-w-[56ch] text-lg text-text-dim">
          The Laboratory of Data Quality and Intelligent Security at RIT builds the methods, models,
          and systems that make modern data infrastructure verifiable, resilient, and worthy of
          trust — from sensor networks at the edge to large-scale ML systems at the core.
        </p>
        <div class="flex flex-wrap gap-[14px]">
          <a
            href="#research"
            class="inline-flex items-center gap-2 rounded-full px-[22px] py-[14px] text-sm font-medium transition-transform hover:-translate-y-[1px]"
            style="background: var(--color-rit-orange); color: #0a0e13;"
          >
            Explore the research →
          </a>
          <a
            href="#support"
            class="inline-flex items-center gap-2 rounded-full border border-line px-[22px] py-[14px] text-sm font-medium text-text hover:border-text-dim"
          >
            Support our work
          </a>
        </div>

        {/* STATS */}
        <div
          class="mt-20 grid grid-cols-2 gap-px overflow-hidden rounded-[14px] border border-line md:grid-cols-4"
          style="background: var(--color-line);"
        >
          {[
            // Counted from the projects collection, so it never drifts from the list below.
            { num: `${projects.length}`, label: "Open-source projects" },
            { num: "25+", label: "Researchers trained" },
            // research(2026-06): the live count of the imported publication
            // record (`allPubs.length` from src/data/publications-all.json) —
            // Dr. Reznik's complete OpenAlex-indexed body of work, the same
            // figure the /publications page shows. Dynamic so it never drifts;
            // the trailing "+" hedges OpenAlex coverage gaps. Replaces a
            // hand-scoped "90+" RIT-era CV estimate that undercounted the record.
            { num: `${allPubs.length}+`, label: "Peer-reviewed publications" },
            // research(2026-05): RIT lab era. L. Reznik joined RIT ~2003
            // (Victoria U. 1996-2001, UT El Paso ~2002), so ~22 years;
            // "20+" rounds down. Pre-RIT career work is excluded here.
            { num: "20+", label: "Years of research" },
          ].map(({ num, label }) => (
            <div class="bg-bg px-6 py-7">
              <div style="font-family: var(--font-display); font-size: 44px; line-height: 1; color: var(--color-rit-orange-text);">
                {num}
              </div>
              <div class="mt-[6px] text-[13px] tracking-[0.5px] text-text-dim uppercase">
                {label}
              </div>
            </div>
          ))}
        </div>
      </div>
    </header>

    {/* RESEARCH AREAS */}
    <section id="research" class="relative py-[100px]">
      <div class="mx-auto max-w-[1200px] px-6">
        <div class="mb-4 text-xs tracking-[1.5px] text-rit-orange-text uppercase">
          Research Areas
        </div>
        <h2
          class="mb-6 max-w-[22ch]"
          style="font-family: var(--font-display); font-size: clamp(36px, 5vw, 56px); line-height: 1.05; letter-spacing: -1px; text-wrap: balance;"
        >
          Six frontiers we're pushing in parallel.
        </h2>
        <p class="mb-14 max-w-[64ch] text-lg text-text-dim">
          Our work sits at the intersection of data quality, security, and intelligent systems —
          with a hard focus on what's deployable, measurable, and trustworthy.
        </p>
        <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
          {researchAreas.map((area) => (
            <article class="rounded-[14px] border border-line bg-bg-elev p-8 transition-all hover:-translate-y-[2px] hover:border-rit-orange">
              <span
                class="mb-6 block text-sm italic"
                style="font-family: var(--font-display); color: var(--color-rit-orange-text);"
              >
                — {area.n}
              </span>
              <div class="mb-3 text-[22px] leading-[1.2] font-medium">{area.title}</div>
              <p class="text-[15px] text-text-dim">{area.desc}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    {/* PROJECTS */}
    <section id="projects" data-pagefind-ignore class="relative py-[100px]">
      <div class="mx-auto max-w-[1200px] px-6">
        <div class="mb-4 text-xs tracking-[1.5px] text-rit-orange-text uppercase">
          Active Projects
        </div>
        <h2
          class="mb-6 max-w-[22ch]"
          style="font-family: var(--font-display); font-size: clamp(36px, 5vw, 56px); line-height: 1.05; letter-spacing: -1px; text-wrap: balance;"
        >
          What we're shipping right now.
        </h2>
        <p class="mb-14 max-w-[64ch] text-lg text-text-dim">
          Open-source frameworks, peer-reviewed methods, and end-to-end systems — built by the
          current cohort and used by researchers beyond LDQIS.
        </p>
        <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
          {research.map((p) => (
            <ProjectCard p={p} experimentTotal={experimentTotals.get(p.id)} />
          ))}
        </div>
        {software.length > 0 && (
          <>
            <h3 class="mt-20 mb-3 text-2xl font-medium text-text">Software</h3>
            <p class="mb-8 max-w-[64ch] text-text-dim">
              Tools built in the lab for everyday research and development work, free for anyone to
              use.
            </p>
            <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
              {software.map((p) => (
                <ProjectCard p={p} compact />
              ))}
            </div>
          </>
        )}
      </div>
    </section>

    {/* PUBLICATIONS */}
    <section id="publications" data-pagefind-ignore class="relative py-[100px]">
      <div class="mx-auto max-w-[1200px] px-6">
        <div class="mb-4 text-xs tracking-[1.5px] text-rit-orange-text uppercase">Publications</div>
        <h2
          class="mb-6 max-w-[22ch]"
          style="font-family: var(--font-display); font-size: clamp(36px, 5vw, 56px); line-height: 1.05; letter-spacing: -1px; text-wrap: balance;"
        >
          Selected publications.
        </h2>
        <p class="mb-14 max-w-[64ch] text-lg text-text-dim">
          A handful of highlights from the lab's work. See the full publication record below, or Dr.
          Reznik's{" "}
          <a
            href={SCHOLAR_URL}
            target="_blank"
            rel="noopener"
            class="border-b"
            style="color: var(--color-rit-orange-text); border-color: color-mix(in oklab, var(--color-rit-orange) 8%, transparent);"
          >
            Google Scholar profile
          </a>{" "}
          for citation metrics.
        </p>
        <div class="flex flex-col gap-4">
          {publications.map((pub) => (
            <article class="grid grid-cols-1 items-center gap-6 rounded-[14px] border border-line bg-bg-elev p-6 hover:border-rit-orange md:grid-cols-[auto_1fr_auto] md:px-7">
              <div
                class="text-4xl leading-none"
                style="font-family: var(--font-display); color: var(--color-rit-orange-text); letter-spacing: -1px;"
              >
                {pub.year}
              </div>
              <div class="min-w-0">
                <div class="mb-[6px] text-[11px] tracking-[1.5px] text-text-faint uppercase">
                  {pub.venue}
                </div>
                <a
                  href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/publications/${pub.id}/`}
                  class="mb-1 inline-block text-[17px] leading-[1.35] font-medium hover:text-rit-orange-text"
                >
                  {pub.title}
                </a>
                <div class="text-[13px] text-text-dim">{pub.authors}</div>
                {pub.project && (
                  <a
                    href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/projects/${pub.project.id}/`}
                    class="mt-[6px] inline-flex items-center gap-1 text-[12px] hover:underline"
                    style="color: var(--color-rit-orange-text);"
                  >
                    <span aria-hidden="true">⟨/⟩</span> Code ·{" "}
                    {projectNamesById.get(pub.project.id)} →
                  </a>
                )}
              </div>
              <a
                href={pub.link.href}
                target="_blank"
                rel="noopener"
                class="inline-flex items-center gap-[6px] justify-self-start rounded-full border border-line px-[14px] py-2 text-[13px] whitespace-nowrap text-text-dim hover:border-rit-orange hover:text-rit-orange-text md:justify-self-auto"
              >
                {pub.link.label}
              </a>
            </article>
          ))}
        </div>
        <div class="mt-12">
          <a
            href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/publications/`}
            class="inline-flex items-center gap-2 rounded-full border border-line px-[22px] py-[14px] text-sm font-medium text-text hover:border-rit-orange hover:text-rit-orange-text"
          >
            See all {allPubs.length} publications →
          </a>
        </div>
      </div>
    </section>

    {/* PEOPLE */}
    <section
      id="people"
      data-pagefind-ignore
      class="relative py-[100px]"
      style="background: var(--color-bg-elev); border-top: 1px solid var(--color-line); border-bottom: 1px solid var(--color-line);"
    >
      <div class="mx-auto max-w-[1200px] px-6">
        <div class="mb-4 text-xs tracking-[1.5px] text-rit-orange-text uppercase">People</div>
        <h2
          class="mb-6 max-w-[22ch]"
          style="font-family: var(--font-display); font-size: clamp(36px, 5vw, 56px); line-height: 1.05; letter-spacing: -1px; text-wrap: balance;"
        >
          The team — past and present.
        </h2>
        <p class="mb-14 max-w-[64ch] text-lg text-text-dim">
          LDQIS is the work of every researcher who has passed through it. Today's team is pushing
          on federated learning and agentic AI; previous cohorts built the foundations in mobile
          security, data quality evaluation, wearable sensors, and computational intelligence that
          made today's work possible.
        </p>

        <div class="mb-6 flex items-baseline gap-4">
          <span
            class="text-[11px] tracking-[1.5px] uppercase"
            style="color: var(--color-rit-orange-text);"
          >
            Now
          </span>
          <h3
            class="font-normal"
            style="font-family: var(--font-display); font-size: 28px; letter-spacing: -0.5px;"
          >
            Current Team
          </h3>
          <span class="text-[13px] text-text-dim">Federated learning · Agentic AI</span>
        </div>

        <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 md:grid-cols-4">
          {currentTeam.map((p) => (
            <div
              class={`rounded-[14px] border border-line bg-bg-elev p-6 transition-colors hover:border-rit-orange ${p.lead ? "sm:col-span-2 md:col-span-2" : ""}`}
              style={
                p.lead
                  ? "background: linear-gradient(135deg, var(--color-bg-elev), var(--color-bg-soft));"
                  : undefined
              }
            >
              <div class="mb-4 flex items-center gap-3">
                <Avatar
                  avatar={p.avatar}
                  github={p.github}
                  initials={p.initials}
                  name={p.name}
                  transitionName={`avatar-${p.id}`}
                />
                <a
                  href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/people/${p.id}/`}
                  class="inline-block text-base font-medium hover:text-rit-orange-text"
                >
                  {p.name}
                </a>
              </div>
              <div class="text-[13px] text-text-dim">{p.role}</div>
              {p.years && <div class="mt-1 text-xs text-text-dim">{p.years}</div>}
              <ContactLinks
                email={p.email}
                scholar={p.scholar}
                ieee={p.ieee}
                website={p.website}
                github={p.github}
                linkedin={p.linkedin}
                youtube={p.youtube}
                orcid={p.orcid}
                name={p.name}
              />
            </div>
          ))}
        </div>

        <div class="mt-14 mb-6 flex items-baseline gap-4 border-t border-line pt-4">
          <span
            class="text-[11px] tracking-[1.5px] uppercase"
            style="color: var(--color-rit-orange-text);"
          >
            Then
          </span>
          <h3
            id="alumni"
            class="font-normal"
            style="font-family: var(--font-display); font-size: 28px; letter-spacing: -0.5px;"
          >
            Past Research Cohort
          </h3>
          <span class="text-[13px] text-text-dim">
            Mobile security · Android attacks · Wearable sensors · Data quality · Computational
            intelligence
          </span>
        </div>

        <p class="mb-8 max-w-[64ch] text-sm text-text-dim">
          These researchers led work that remains foundational to LDQIS today, including our Android
          security apps, the NSF Data Quality &amp; Security Evaluation Framework, and the
          wearable-sensors and computational-intelligence research lines that preceded today's
          federated learning work.
        </p>

        <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 md:grid-cols-4">
          {pastCohort.map((p) => (
            <div class="rounded-[14px] border border-line bg-bg-elev p-6 transition-colors hover:border-rit-orange">
              <div class="mb-4 flex items-center gap-3">
                <Avatar
                  avatar={p.avatar}
                  github={p.github}
                  initials={p.initials}
                  name={p.name}
                  transitionName={`avatar-${p.id}`}
                />
                <a
                  href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/people/${p.id}/`}
                  class="inline-block text-base font-medium hover:text-rit-orange-text"
                >
                  {p.name}
                </a>
              </div>
              <div class="text-[13px] text-text-dim">{p.role}</div>
              {p.years && <div class="mt-1 text-xs text-text-dim">{p.years}</div>}
              <ContactLinks
                email={p.email}
                scholar={p.scholar}
                ieee={p.ieee}
                website={p.website}
                github={p.github}
                linkedin={p.linkedin}
                youtube={p.youtube}
                orcid={p.orcid}
                name={p.name}
              />
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* TEACHING */}
    <section id="teaching" class="relative py-[100px]">
      <div class="mx-auto max-w-[1200px] px-6">
        <div class="mb-4 text-xs tracking-[1.5px] text-rit-orange-text uppercase">Teaching</div>
        <h2
          class="mb-6 max-w-[22ch]"
          style="font-family: var(--font-display); font-size: clamp(36px, 5vw, 56px); line-height: 1.05; letter-spacing: -1px; text-wrap: balance;"
        >
          From the lecture hall to the lab.
        </h2>
        <p class="mb-14 max-w-[64ch] text-lg text-text-dim">
          Lab members teach across RIT's undergraduate and graduate computer science curriculum —
          the same areas the lab researches, from intelligent systems and security measurement to
          neural networks and intelligent security. For schedules and current materials, see Dr.
          Reznik's{" "}
          <a
            href="https://www.cs.rit.edu/~lr/"
            target="_blank"
            rel="noopener"
            class="border-b"
            style="color: var(--color-rit-orange-text); border-color: color-mix(in oklab, var(--color-rit-orange) 8%, transparent);"
          >
            course pages
          </a>
          .
        </p>
        <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
          {["Undergraduate", "Graduate"].map((level) => {
            const items = courses.filter((c) => c.level === level);
            return (
              <article class="rounded-[14px] border border-line bg-bg-elev p-8">
                <div class="mb-6 flex items-baseline justify-between gap-3">
                  <h3
                    class="font-normal"
                    style="font-family: var(--font-display); font-size: 22px; letter-spacing: -0.5px;"
                  >
                    {level}
                  </h3>
                  <span class="text-[12px] tracking-[1px] text-text-faint uppercase">
                    {items.length} courses
                  </span>
                </div>
                <ul class="flex flex-col">
                  {items.map((c) => (
                    <li class="flex flex-col gap-1 border-t border-line py-4 first:border-t-0 first:pt-0 last:pb-0 sm:flex-row sm:items-baseline sm:gap-4">
                      <span class="font-mono text-[12px] tracking-[0.5px] text-text-faint sm:w-[84px] sm:shrink-0">
                        {c.code}
                      </span>
                      <span class="text-[16px] leading-[1.3]">{c.title}</span>
                    </li>
                  ))}
                </ul>
              </article>
            );
          })}
        </div>
      </div>
    </section>

    {/* FUNDED BY */}
    <section id="funding" class="relative py-[100px]">
      <div class="mx-auto max-w-[1200px] px-6">
        <div class="mb-4 text-xs tracking-[1.5px] text-rit-orange-text uppercase">Funded By</div>
        <h2
          class="mb-6 max-w-[22ch]"
          style="font-family: var(--font-display); font-size: clamp(36px, 5vw, 56px); line-height: 1.05; letter-spacing: -1px; text-wrap: balance;"
        >
          Backed by competitive research awards.
        </h2>
        <p class="mb-14 max-w-[64ch] text-lg text-text-dim">
          LDQIS research has been supported by the National Science Foundation, the U.S. Department
          of Defense, and CRDF Global with the U.S. Department of State.
        </p>
        <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
          {funders.map((f) => (
            <article class="flex flex-col rounded-[14px] border border-line bg-bg-elev p-8 transition-all hover:-translate-y-[2px] hover:border-rit-orange">
              <div
                class="mb-3 text-[11px] tracking-[1.5px] uppercase"
                style="color: var(--color-rit-orange-text);"
              >
                {f.agency}
              </div>
              <div class="mb-4 text-[19px] leading-[1.3] font-medium">{f.program}</div>
              <div class="mt-auto flex flex-wrap items-center gap-x-3 gap-y-1 border-t border-line pt-[18px] text-[13px] text-text-dim">
                <span class="font-mono text-text-faint">{f.award}</span>
                <span aria-hidden="true">·</span>
                <span>{f.years}</span>
                {f.url && (
                  <a
                    href={f.url}
                    target="_blank"
                    rel="noopener"
                    class="ml-auto inline-flex items-center gap-1 hover:text-rit-orange-text"
                    style="color: var(--color-rit-orange-text);"
                    aria-label={`View award ${f.award} on nsf.gov`}
                  >
                    View award →
                  </a>
                )}
              </div>
            </article>
          ))}
        </div>
        <p class="mt-10 max-w-[80ch] text-xs leading-[1.7] text-text-faint">
          Any opinions, findings, and conclusions or recommendations expressed on this site are
          those of the authors and do not necessarily reflect the views of the National Science
          Foundation, the U.S. Department of Defense, or other funding agencies.
        </p>
      </div>
    </section>

    {/* GET INVOLVED */}
    <section id="support" class="relative py-[100px]">
      <div class="mx-auto max-w-[1200px] px-6">
        <div
          class="relative overflow-hidden rounded-[14px] border border-line px-12 py-16 text-center"
          style="background: linear-gradient(135deg, var(--color-bg-soft), var(--color-bg-elev));"
        >
          <div
            class="pointer-events-none absolute"
            style="top: -50%; left: 50%; transform: translateX(-50%); width: 600px; height: 600px; background: radial-gradient(circle, color-mix(in oklab, var(--color-rit-orange) 8%, transparent), transparent 70%);"
          ></div>
          <div class="relative">
            <div
              class="mb-4 text-xs tracking-[1.5px] uppercase"
              style="color: var(--color-rit-orange-text);"
            >
              Get Involved
            </div>
            <h3
              class="mx-auto mb-4 max-w-[22ch]"
              style="font-family: var(--font-display); font-size: clamp(32px, 4vw, 48px); line-height: 1.1;"
            >
              Support research that makes data trustworthy.
            </h3>
            <p class="mx-auto mb-8 max-w-[50ch] text-text-dim">
              Funding from individuals, foundations, and industry partners directly supports
              graduate stipends, equipment, and open-source releases. Every contribution compounds —
              in students trained, papers published, and tools shipped.
            </p>
            <div class="flex flex-wrap justify-center gap-[14px]">
              <a
                href="https://www.rit.edu/giving/"
                target="_blank"
                rel="noopener"
                class="inline-flex items-center gap-2 rounded-full px-[22px] py-[14px] text-sm font-medium transition-transform hover:-translate-y-[1px]"
                style="background: var(--color-rit-orange); color: #0a0e13;"
              >
                Become a supporter →
              </a>
              <a
                href="mailto:lrvcs@rit.edu?subject=LDQIS%20Industry%20Partnership"
                class="inline-flex items-center gap-2 rounded-full border border-line px-[22px] py-[14px] text-sm font-medium hover:border-text-dim"
              >
                Partner with us
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
