---
import { Font } from "astro:assets";
import "../styles/global.css";
import SiteFooter from "../components/SiteFooter.astro";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  /** false keeps the page out of the Pagefind index. */
  indexed?: boolean;
}

const {
  title = "LDQIS — Laboratory of Data Quality & Intelligent Security at RIT",
  description = "Research at the frontier of federated learning, agentic AI, and intelligent security. A research laboratory at the Rochester Institute of Technology.",
  canonical = Astro.url.href,
  ogImage,
  indexed = true,
} = Astro.props;
// Result title: the page name without the site suffix.
const pageTitle = title.replace(/\s+[·—]\s+LDQIS\b.*$/, "") || title;
// Default the share image to /og-image.png under the site's base path.
const ogImageUrl =
  ogImage ??
  new URL(`${import.meta.env.BASE_URL.replace(/\/$/, "")}/og-image.png`, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <!-- Body text (Inter 400) and headings (Instrument Serif 400) are preloaded so text does
         not rewrap when the fonts arrive. -->
    <Font cssVariable="--font-inter" preload={[{ weight: "400", style: "normal" }]} />
    <Font cssVariable="--font-instrument-serif" preload={[{ weight: "400", style: "normal" }]} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="LDQIS — Rochester Institute of Technology" />
    <link rel="canonical" href={canonical} />

    {/* Open Graph */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="LDQIS @ RIT" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    {/* Twitter falls back to OG */}
    <meta name="twitter:card" content="summary_large_image" />

    {/* theme-color matches active mode bg */}
    <meta name="theme-color" content="#fefefd" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0e13" media="(prefers-color-scheme: dark)" />

    {/* favicon — inline SVG matching the wordmark mark */}
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='14' fill='%23F76902'/%3E%3Cpath d='M22 18v28h22' stroke='white' stroke-width='6' stroke-linecap='round' stroke-linejoin='round' fill='none'/%3E%3C/svg%3E"
    />

    {/* FOUC prevention — set the theme before first paint: an explicit stored
        choice wins, otherwise follow the OS via prefers-color-scheme, else light. */}
    <script is:inline>
      (function () {
        try {
          const stored = localStorage.getItem("ldqis-theme");
          const prefersDark =
            window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches;
          if (stored === "dark" || (stored !== "light" && prefersDark)) {
            document.documentElement.setAttribute("data-theme", "dark");
          }
        } catch {
          /* localStorage / matchMedia blocked is fine — stay on light theme */
        }
      })();
    </script>
    {/* Per-page head extras — e.g. citation_* meta + JSON-LD on publications */}
    <slot name="head" />
  </head>
  <body
    data-pagefind-body={indexed ? "" : undefined}
    class="overflow-x-hidden bg-bg font-sans text-text antialiased transition-colors duration-200"
    style="font-family: var(--font-sans);"
  >
    <a href="#main" class="skip-link" data-pagefind-ignore>
      Skip to main content
    </a>
    <span hidden data-pagefind-ignore data-pagefind-meta="title">
      {pageTitle}
    </span>
    <slot />
    <SiteFooter />
  </body>
</html>
