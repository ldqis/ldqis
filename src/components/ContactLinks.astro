---
// Shared contact/social-link row for a person. Single source of truth for which
// links render, their order, icons, and external-link a11y.
//   variant="compact" (team cards) — icon-only row; each link carries a
//     visually-hidden label. research(2026-05): use sr-only text, NOT aria-label —
//     browser translation tools skip aria-label, and voice-control matches the
//     visible/accessible name (Adrian Roselli / W3C ARIA8). SVG is aria-hidden.
//   variant="pill" (detail page) — icon + visible label text.
// GitHub/LinkedIn/YouTube marks are the same SVGs as ajbarea.github.io, for
// visual consistency across the sites.
interface Props {
  email?: string;
  scholar?: string;
  ieee?: string;
  website?: string;
  github?: string;
  linkedin?: string;
  youtube?: string;
  orcid?: string;
  name: string;
  variant?: "compact" | "pill";
}
const {
  email,
  scholar,
  ieee,
  website,
  github,
  linkedin,
  youtube,
  orcid,
  name,
  variant = "compact",
} = Astro.props;

type Kind = "github" | "linkedin" | "youtube" | "website" | "scholar" | "orcid" | "ieee" | "email";
type Link = { kind: Kind; href: string; label: string; external: boolean };
const links: Link[] = [
  github
    ? { kind: "github", href: `https://github.com/${github}`, label: "GitHub", external: true }
    : null,
  linkedin ? { kind: "linkedin", href: linkedin, label: "LinkedIn", external: true } : null,
  youtube ? { kind: "youtube", href: youtube, label: "YouTube", external: true } : null,
  website ? { kind: "website", href: website, label: "Website", external: true } : null,
  scholar ? { kind: "scholar", href: scholar, label: "Google Scholar", external: true } : null,
  orcid
    ? { kind: "orcid", href: `https://orcid.org/${orcid}`, label: "ORCID", external: true }
    : null,
  ieee ? { kind: "ieee", href: ieee, label: "IEEE Xplore", external: true } : null,
  email ? { kind: "email", href: `mailto:${email}`, label: email, external: false } : null,
].filter((l): l is Link => l !== null);

const isPill = variant === "pill";
const wrapClass = isPill
  ? "flex flex-wrap items-center gap-3"
  : "mt-3 flex flex-wrap items-center gap-1";
const linkClass = isPill
  ? "inline-flex items-center gap-2 rounded-full border border-line px-[18px] py-[10px] text-sm hover:border-rit-orange"
  : "inline-flex items-center justify-center p-1.5 text-text-dim transition-colors hover:text-rit-orange-text"; // p-1.5 keeps the tap target ≥24px
const iconClass = isPill ? "h-4 w-4 shrink-0" : "h-5 w-5 shrink-0";
---

{links.length > 0 && (
  <div class={wrapClass} data-pagefind-ignore>
    {links.map((link) =>
      link.kind === "email" && isPill ? (
        <div
          class="email-chip relative inline-flex items-center rounded-full border border-line text-sm transition-colors hover:border-rit-orange"
          style="color: var(--color-rit-orange-text);"
        >
          <a
            href={link.href}
            class="inline-flex items-center gap-2 rounded-l-full py-[10px] pr-2.5 pl-[18px] transition-colors hover:bg-bg-soft"
          >
            <svg
              class={iconClass}
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <rect x="3" y="5" width="18" height="14" rx="2" />
              <path d="m3 7 9 6 9-6" />
            </svg>
            <span class="break-all">{link.label}</span>
          </a>
          <button
            type="button"
            class="copy-email inline-flex items-center self-stretch rounded-r-full border-l border-line px-3 transition-colors hover:bg-bg-soft"
            data-copy={email}
          >
            <svg
              class="copy-glyph h-4 w-4 shrink-0"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <rect x="9" y="9" width="13" height="13" rx="2" />
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
            </svg>
            <svg
              class="check-glyph hidden h-4 w-4 shrink-0"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M20 6 9 17l-5-5" />
            </svg>
            <span class="sr-only">Copy {name}'s email address</span>
          </button>
          <span class="copied-bubble" role="status" aria-live="polite" />
        </div>
      ) : (
        <a
          href={link.href}
          class={linkClass}
          {...(isPill ? { style: "color: var(--color-rit-orange-text);" } : {})}
          {...(link.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
        >
          {link.kind === "github" && (
            <svg class={iconClass} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path
                fill-rule="evenodd"
                clip-rule="evenodd"
                d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
              />
            </svg>
          )}
          {link.kind === "linkedin" && (
            <svg class={iconClass} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
            </svg>
          )}
          {link.kind === "youtube" && (
            <svg class={iconClass} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z" />
            </svg>
          )}
          {link.kind === "website" && (
            <svg
              class={iconClass}
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="10" />
              <path d="M2 12h20" />
              <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
            </svg>
          )}
          {link.kind === "scholar" && (
            <svg
              class={iconClass}
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M12 4 2 9l10 5 10-5-10-5Z" />
              <path d="M5 11v5c0 1.1 3.1 3 7 3s7-1.9 7-3v-5" />
            </svg>
          )}
          {link.kind === "orcid" && (
            <svg class={iconClass} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 0C5.372 0 0 5.372 0 12s5.372 12 12 12 12-5.372 12-12S18.628 0 12 0zM7.369 4.378c.525 0 .947.431.947.947 0 .525-.422.947-.947.947-.525 0-.946-.422-.946-.947 0-.516.421-.947.946-.947zm-.722 3.038h1.444v10.041H6.647V7.416zm3.562 0h3.9c3.712 0 5.344 2.653 5.344 5.025 0 2.578-2.016 5.025-5.325 5.025h-3.919V7.416zm1.444 1.303v7.444h2.297c2.359 0 3.588-1.444 3.588-3.722 0-2.016-1.091-3.722-3.588-3.722h-2.297z" />
            </svg>
          )}
          {link.kind === "ieee" && (
            <svg
              class={iconClass}
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M14 3v4a1 1 0 0 0 1 1h4" />
              <path d="M17 21H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h7l5 5v11a2 2 0 0 1-2 2Z" />
              <path d="M9 13h6M9 17h6" />
            </svg>
          )}
          {link.kind === "email" && (
            <svg
              class={iconClass}
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <rect x="3" y="5" width="18" height="14" rx="2" />
              <path d="m3 7 9 6 9-6" />
            </svg>
          )}
          {isPill ? (
            <span class={link.kind === "email" ? "break-all" : ""}>{link.label}</span>
          ) : (
            <span class="sr-only">
              {link.kind === "email" ? `Email ${name}` : `${name} on ${link.label}`}
            </span>
          )}
          {isPill && link.external && <span aria-hidden="true">↗</span>}
        </a>
      ),
    )}
  </div>
)}

{/* Progressive enhancement: copy the email to the clipboard. The address is
    still visible and the mailto link still works with JS off — this is a bonus. */}
<script>
  document.querySelectorAll("button.copy-email[data-copy]").forEach((btn) => {
    const chip = btn.closest(".email-chip");
    const copyGlyph = btn.querySelector(".copy-glyph");
    const checkGlyph = btn.querySelector(".check-glyph");
    const bubble = chip?.querySelector(".copied-bubble");
    let timer: ReturnType<typeof setTimeout> | undefined;
    btn.addEventListener("click", async () => {
      const text = btn.getAttribute("data-copy");
      if (!text) return;
      try {
        await navigator.clipboard.writeText(text);
      } catch {
        return;
      }
      chip?.classList.add("is-copied");
      copyGlyph?.classList.add("hidden");
      checkGlyph?.classList.remove("hidden");
      if (bubble) bubble.textContent = "Copied!";
      clearTimeout(timer);
      timer = setTimeout(() => {
        chip?.classList.remove("is-copied");
        copyGlyph?.classList.remove("hidden");
        checkGlyph?.classList.add("hidden");
        if (bubble) bubble.textContent = "";
      }, 1500);
    });
  });
</script>

<style>
  /* Success state: the icon swaps to a green check and a "Copied!" bubble
     confirms. research(2026-05): an icon swap is the copy confirmation users
     actually register; a text-only "Copy"->"Copied" swap reads as no change. */
  .check-glyph {
    color: #16a34a;
  }
  .email-chip.is-copied {
    border-color: #16a34a;
  }
  .copied-bubble {
    position: absolute;
    right: 6px;
    bottom: calc(100% + 6px);
    border-radius: 9999px;
    background: #16a34a;
    padding: 2px 8px;
    font-size: 11px;
    font-weight: 600;
    color: #fff;
    white-space: nowrap;
    opacity: 0;
    transform: translateY(4px);
    transition:
      opacity 0.15s ease,
      transform 0.15s ease;
    pointer-events: none;
  }
  .email-chip.is-copied .copied-bubble {
    opacity: 1;
    transform: translateY(0);
  }
</style>
