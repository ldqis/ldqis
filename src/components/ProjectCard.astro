---
// One project card on the homepage. `compact` is the smaller software-tool variant.
import type { CollectionEntry } from "astro:content";

interface Props {
  p: CollectionEntry<"projects">["data"] & { id: string };
  experimentTotal?: number;
  compact?: boolean;
}

const { p, experimentTotal, compact = false } = Astro.props;
// Cards sit under the section's "Research projects" or "Agentic AI tools" subheading.
const Heading = "h4";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<article class="flex flex-col border-t border-line pt-6 pb-12">
  <p class="mb-3 text-[13px] text-rit-orange-text">{p.tags.join(", ")}</p>
  <Heading
    class="mb-1 leading-[1.1]"
    style={`font-family: var(--font-display); font-size: ${compact ? 26 : 32}px; letter-spacing: -0.5px;`}
  >
    <a href={`${base}/projects/${p.id}/`} class="hover:text-rit-orange-text">
      {p.name}
    </a>
  </Heading>
  <p class="mb-4 text-[15px] text-text-dim italic">{p.tagline}</p>
  <p
    class="mb-4 max-w-[60ch] flex-grow text-[15px] leading-relaxed text-text-dim"
    set:html={p.desc}
  />
  <p class="mb-5 text-[13px] text-text-faint">Built with {p.stack.join(", ")}</p>
  {experimentTotal !== undefined && (
    <a
      href={`${base}/projects/${p.id}/#experiments`}
      class="mb-5 self-start text-sm text-text hover:text-rit-orange-text"
    >
      <span style="font-family: var(--font-display); font-size: 22px;">
        {experimentTotal.toLocaleString("en-US")}
      </span>{" "}
      experiments run so far<span class="sr-only"> with {p.name}</span>
    </a>
  )}
  <div class="flex flex-wrap gap-x-5 gap-y-2 text-sm">
    {p.links.map((l) => (
      <a
        href={l.href}
        target="_blank"
        rel="noopener"
        class="text-rit-orange-text underline-offset-4 hover:underline"
      >
        {l.label}
        <span class="sr-only"> ({p.name})</span>
      </a>
    ))}
    <a
      href={`${base}/projects/${p.id}/`}
      class="text-text-dim underline-offset-4 hover:text-rit-orange-text hover:underline"
    >
      Project page<span class="sr-only"> for {p.name}</span>
    </a>
  </div>
</article>
