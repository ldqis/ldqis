---
import { CONTACT_EMAIL, footerGroups } from "../lib/site-links";

// research(2026-10): recognized lab sites are restrained (typography, spacing and hierarchy do
// the work; text separated by lines rather than boxes), and current footer practice favors a
// light, sparse footer: contact details plus the few links the header lacks. So the footer
// follows the site's own theme tokens under a hairline, not a borrowed institutional block.
// Sources: thisisvisceral.com (Flatiron, Biohub), the-scientist.com lab website awards,
// orbitmedia.com footer guidance.
const groups = footerGroups(import.meta.env.BASE_URL);
const linkClass = "text-text-dim underline-offset-4 hover:text-rit-orange-text hover:underline";
---

<footer id="site-footer" class="relative z-[1] border-t border-line">
  <div class="mx-auto max-w-[1200px] px-6 pt-10 pb-8">
    <div class="grid gap-10 md:grid-cols-[1fr_auto] md:gap-16">
      <address class="text-sm leading-relaxed text-text-dim not-italic">
        <p
          class="mb-3 text-text"
          style="font-family: var(--font-display); font-size: 24px; line-height: 1.15; letter-spacing: -0.3px;"
        >
          Laboratory of Data Quality and Intelligent Security
        </p>
        <p>
          <a href="https://www.rit.edu/computing/" class={linkClass}>
            Golisano College of Computing and Information Sciences
          </a>
          <br />
          Rochester Institute of Technology, 1 Lomb Memorial Drive, Rochester, NY 14623
        </p>
        <p class="mt-3">
          <a href={`mailto:${CONTACT_EMAIL}`} class={linkClass}>
            {CONTACT_EMAIL}
          </a>
        </p>
      </address>

      <nav aria-label="Footer" class="grid grid-cols-2 gap-x-14 gap-y-8 text-sm">
        {groups.map((g) => (
          <div>
            <h2 class="mb-3 text-[13px] font-medium text-text">{g.heading}</h2>
            <ul class="space-y-1.5">
              {g.links.map((l) => (
                <li>
                  <a href={l.href} class={linkClass}>
                    {l.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </nav>
    </div>

    <p class="mt-8 text-xs text-text-faint">
      &copy; {new Date().getFullYear()} Laboratory of Data Quality and Intelligent Security
    </p>
  </div>
</footer>
